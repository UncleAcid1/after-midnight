<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ScrollingDemo" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="default">
				<Option output="ScrollingDemo" prefix_auto="0" extension_auto="1" />
				<Option type="0" />
				<Option compiler="gcc" />
			</Target>
		</Build>
		<Compiler>
			<Add option="-Dmain=SDL_main" />
			<Add directory="../../Headers" />
			<Add directory="../../Utils" />
		</Compiler>
		<Linker>
			<Add option="../../Libraries/libSpriteWorldX.a" />
			<Add option="-mwindows" />
			<Add library="mingw32" />
			<Add library="SDLmain" />
			<Add library="SDL" />
			<Add library="opengl32" />
			<Add directory="../../Libraries" />
		</Linker>
		<Unit filename="ScrollingDemo.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="ScrollingDemo.h">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
